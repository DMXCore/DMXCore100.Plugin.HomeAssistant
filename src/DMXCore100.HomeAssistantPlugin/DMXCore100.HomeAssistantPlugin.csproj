<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The SDK generates manifest.json and PluginBuildInfo from these -->
    <PluginId>home-assistant</PluginId>
    <PluginDisplayName>Home Assistant</PluginDisplayName>
    <Version>1.2.1</Version>
    <Authors>DMX Core</Authors>
    <!-- Floor: oldest SDK contract this plugin actually requires. mDNS URL
         hints need 1.1; without this override the floor would default to the
         contract of the SDK assembly we compile against. -->
    <PluginMinSdkVersion>1.1</PluginMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DMXCore100.HomeAssistantPlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime": the DMX Core 100 host provides the SDK (and
         its dependencies) at runtime and always resolves them to its own
         copies, so they must not be shipped inside the .dmxplugin. -->
    <PackageReference Include="DMXCore.PluginSdk" Version="1.*" ExcludeAssets="runtime" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

</Project>
